# Telegram user account (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
TG_SESSION=agent
# Who the agent writes to (test: your second account; final: @vlad_dev_7)
TARGET=@vlad_dev_7
# Where the agent asks its owner when it lacks a fact: "me" = Saved Messages, or @username
OWNER_CHAT=me

# LLM: any OpenAI-compatible endpoint. Default: Alibaba Model Studio (Singapore)
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# Booking facts: the only facts the agent may use. Leave empty what you do not want to give.
GUEST_NAME=
GUEST_PHONE=
PARTY_SIZE=2
BOOKING_TIME=17:00
BOOKING_TZ=Europe/London
# Usually unknown: the agent asks the manager
RESTAURANT_NAME=

# Voice (optional): Zonos TTS and Whisper STT on a GPU machine, via SSH tunnel. Empty = text only.
VOICE_TTS_URL=
VOICE_TTS_KEY=
VOICE_NAME=
VOICE_STT_URL=
